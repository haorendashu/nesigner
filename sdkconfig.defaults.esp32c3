# ESP32-C3 Target Configuration
CONFIG_IDF_TARGET="esp32c3"

# Transport selection: Native USB Serial/JTAG (no USB-OTG)
CONFIG_SIGNER_TRANSPORT_USB_SERIAL_JTAG=y

# Disable secondary console on USB Serial/JTAG so it does not conflict with data transport
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# UART fallback configuration (C3 has UART0 and UART1)
CONFIG_SIGNER_UART_PORT_NUM=1
CONFIG_SIGNER_UART_TX_PIN=4
CONFIG_SIGNER_UART_RX_PIN=5
