# ESP32-S31 Target Configuration (320MHz dual-core RISC-V)
CONFIG_IDF_TARGET="esp32s31"

# Clock frequency (320MHz)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_320=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=320

# Primary console on USB Serial/JTAG port for debugging
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Transport selection: TinyUSB (USB 2.0 High Speed OTG)
CONFIG_SIGNER_TRANSPORT_TINYUSB=y
CONFIG_TINYUSB_RHPORT_HS=y
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_CDC_RX_BUFSIZE=1024
CONFIG_TINYUSB_CDC_TX_BUFSIZE=1024

# Hardware crypto acceleration
CONFIG_MBEDTLS_HARDWARE_AES=y
CONFIG_MBEDTLS_HARDWARE_SHA=y

# UART fallback configuration
CONFIG_SIGNER_UART_PORT_NUM=2
CONFIG_SIGNER_UART_TX_PIN=4
CONFIG_SIGNER_UART_RX_PIN=5
