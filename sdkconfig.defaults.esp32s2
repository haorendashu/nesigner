# ESP32-S2 Target Configuration
CONFIG_IDF_TARGET="esp32s2"

# Transport selection: TinyUSB CDC-ACM (USB-OTG)
CONFIG_SIGNER_TRANSPORT_TINYUSB=y

# TinyUSB configuration
CONFIG_TINYUSB_RHPORT_FS=y
CONFIG_TINYUSB_MODE_DMA=y
CONFIG_TINYUSB_TASK_PRIORITY=5
CONFIG_TINYUSB_TASK_STACK_SIZE=4096
CONFIG_TINYUSB_TASK_AFFINITY_CPU0=y
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_CDC_RX_BUFSIZE=512
CONFIG_TINYUSB_CDC_TX_BUFSIZE=512

# UART fallback configuration (S2 has UART0 and UART1)
CONFIG_SIGNER_UART_PORT_NUM=1
CONFIG_SIGNER_UART_TX_PIN=17
CONFIG_SIGNER_UART_RX_PIN=18
